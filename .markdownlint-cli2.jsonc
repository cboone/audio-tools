{
  "config": {
    // Line length: disabled. The prose here is written as one long line per
    // paragraph, with the editor handling visual wrapping.
    "MD013": false,

    // Allow dollar signs before commands. Scrut test files use `$ command`
    // notation throughout.
    "MD014": false,

    // Allow duplicate headings in different sections (e.g. ## Notes).
    "MD024": { "siblings_only": true },

    // Allow inline HTML (<br>, <details>, <kbd>, etc.).
    "MD033": false,

    // Allow bare URLs without angle brackets.
    "MD034": false,

    // Table column style: disabled. Prettier owns table alignment and fixes it
    // automatically; markdownlint has no fixer for this rule at any version,
    // and its default "any" style reports against whichever style is the
    // closest match, which pushes a nearly-aligned table toward compact.
    "MD060": false,
  },

  // Files to ignore
  "ignores": ["node_modules/", ".venv/", "venv/", "CHANGELOG.md"],
}
